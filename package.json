{
  "name": "digital-game-tracker",
  "productName": "Digital Game Tracker",
  "version": "0.1.0",
  "description": "A local, animated game journal with safe TXT imports.",
  "main": "./dist/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "package:portable": "npm run build && cross-env NODE_INSTALLER=npm electron-forge package --platform=win32 --arch=x64",
    "make:zip": "npm run build && cross-env NODE_INSTALLER=npm electron-forge make --platform=win32 --arch=x64 --makers=@electron-forge/maker-zip"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@vitejs/plugin-react": "5.1.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "tsx": "4.23.4",
    "vite": "7.3.1"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
